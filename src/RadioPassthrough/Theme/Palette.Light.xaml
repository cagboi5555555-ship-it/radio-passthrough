<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BaseColor">#FAF9F5</Color>
    <Color x:Key="SurfaceColor">#F0EEE6</Color>
    <Color x:Key="RaisedColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#DDD9CE</Color>
    <Color x:Key="SunkenColor">#E7E4DA</Color>
    <Color x:Key="InkColor">#141413</Color>
    <Color x:Key="Ink2Color">#5F5C54</Color>
    <Color x:Key="Ink3Color">#8A8780</Color>
    <Color x:Key="DimColor">#B0ACA1</Color>
    <Color x:Key="ClayColor">#BC5C36</Color>
    <Color x:Key="CriticalColor">#A83A30</Color>
    <Color x:Key="CautionColor">#8E6F1C</Color>
    <Color x:Key="SettledColor">#4F6B4B</Color>
    <Color x:Key="ShadowColor">#3A3222</Color>

    <SolidColorBrush x:Key="Base" Color="{StaticResource BaseColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Hairline" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Sunken" Color="{StaticResource SunkenColor}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Ink2" Color="{StaticResource Ink2Color}" />
    <SolidColorBrush x:Key="Ink3" Color="{StaticResource Ink3Color}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="Clay" Color="{StaticResource ClayColor}" />
    <SolidColorBrush x:Key="Critical" Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="Caution" Color="{StaticResource CautionColor}" />
    <SolidColorBrush x:Key="Settled" Color="{StaticResource SettledColor}" />

    <SolidColorBrush x:Key="OnClay" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ClayHover" Color="#C86A44" />
    <SolidColorBrush x:Key="ClayPressed" Color="#A8502D" />
    <SolidColorBrush x:Key="RaisedHover" Color="#F7F5EF" />
    <SolidColorBrush x:Key="RowHover" Color="#E9E6DC" />
    <SolidColorBrush x:Key="SwitchOnTrack" Color="#141413" />
    <SolidColorBrush x:Key="SwitchOnKnob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SwitchOffKnob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumb" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MeterFill" Color="#5F5C54" />
    <SolidColorBrush x:Key="MeterFillStrong" Color="#141413" />
    <SolidColorBrush x:Key="WaveBar" Color="#8A8780" />
    <SolidColorBrush x:Key="WaveBand" Color="#E7E4DA" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#B0ACA1" />
    <sys:Double x:Key="ShadowOpacity" xmlns:sys="clr-namespace:System;assembly=System.Runtime">0.16</sys:Double>
</ResourceDictionary>
