<UserControl x:Class="RadioPassthrough.Views.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RadioPassthrough.Controls"
             xmlns:local="clr-namespace:RadioPassthrough">
    <UserControl.Resources>
        <local:CheckLevelToBrush x:Key="LevelBrush" />
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="2,16,2,0">
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Title}" />
            <TextBlock Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                        <Setter Property="Text" Value="Each step below is one click. The app handles the rest." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllReady}" Value="True">
                                <Setter Property="Text" Value="Everything's in place. Join your server and talk on the radio." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <TextBlock Text="Checklist" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border x:Name="Sep" Style="{StaticResource Divider}" />
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,7,0,0"
                                         Fill="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource RowLabel}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Footnote}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SmallPrimaryButton}" Content="{Binding ActionLabel}" Command="{Binding Action}"
                                        Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPrimaryAction, Converter={StaticResource Visible}}" />
                                <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="{Binding ActionLabel}" Command="{Binding Action}"
                                        Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasSecondaryAction, Converter={StaticResource Visible}}" />
                                <c:Spinner Grid.Column="2" Width="16" Height="16" Margin="12,0,6,0" VerticalAlignment="Center"
                                           Visibility="{Binding Busy, Converter={StaticResource Visible}}" />
                            </Grid>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                Visibility="{Binding Message, Converter={StaticResource NotNull}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"
                         Fill="{Binding MessageLevel, Converter={StaticResource LevelBrush}}" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Secondary}" Foreground="{DynamicResource Ink}" />
            </Grid>
        </Border>

        <TextBlock Text="Microphone" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Device" Style="{StaticResource RowLabel}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource PopupButton}" Margin="24,0,0,0"
                              ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMic}" AutomationProperties.Name="Microphone">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Footnote}" Margin="16,8,16,0"
                   Text="Your normal microphone, like Voicemeeter's Stereo Input 1. Its inputs are passed on in stereo, as Voicemeeter did." />

        <TextBlock Text="Windows" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <TextBlock Text="Keep my speakers and mic as the defaults" Style="{StaticResource RowLabel}" Margin="0,0,56,0" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepRealDefaults}" HorizontalAlignment="Right" AutomationProperties.Name="Keep my speakers and mic as the defaults" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid Style="{StaticResource Row}">
                    <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" HorizontalAlignment="Right" AutomationProperties.Name="Start with Windows" />
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Footnote}" Margin="16,8,16,0"
                   Text="If Windows ever makes the cable your default speakers or mic, the app puts yours back straight away. TeamSpeak's mic is the cable on every server, so keep Start with Windows on." />

        <TextBlock Text="Help" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <TextBlock Text="Something not working?" Style="{StaticResource RowLabel}" />
                    <Button Style="{StaticResource SmallButton}" Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" HorizontalAlignment="Right" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid Style="{StaticResource Row}">
                    <TextBlock Text="Log files" Style="{StaticResource RowLabel}" />
                    <Button Style="{StaticResource SmallButton}" Content="Open folder" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Footnote}" Margin="16,8,16,0"
                   Text="Diagnostics list your devices, settings and recent log lines. Paste them in Discord when you ask for help. Nothing is sent anywhere by itself." />

        <TextBlock Text="{Binding Version}" Style="{StaticResource Number}" Foreground="{DynamicResource Dim}" Margin="16,22,16,0" />
    </StackPanel>
</UserControl>
