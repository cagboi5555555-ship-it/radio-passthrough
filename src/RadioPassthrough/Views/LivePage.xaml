<UserControl x:Class="RadioPassthrough.Views.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:c="clr-namespace:RadioPassthrough.Controls">
    <UserControl.Resources>
        <x:Array x:Key="Presets" Type="{x:Type sys:String}">
            <sys:String>Doc 1:1</sys:String>
            <sys:String>Custom</sys:String>
        </x:Array>
    </UserControl.Resources>

    <StackPanel>
        <!-- Hero: are we on the radio right now? -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,20,20,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" VerticalAlignment="Top">
                        <Ellipse x:Name="Disc" StrokeThickness="1">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Sunken}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Hairline}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnAir}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Ink}" />
                                            <Setter Property="Stroke" Value="{DynamicResource Ink}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Canvas Width="52" Height="52">
                            <Canvas.Style>
                                <Style TargetType="Canvas">
                                    <Setter Property="Tag" Value="{DynamicResource Ink3}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnAir}" Value="True">
                                            <Setter Property="Tag" Value="{DynamicResource Base}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Canvas.Style>
                            <Ellipse Canvas.Left="22.5" Canvas.Top="22.5" Width="7" Height="7"
                                     Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M 31.5,20.5 A 7.5,7.5 0 0 1 31.5,31.5 M 20.5,20.5 A 7.5,7.5 0 0 0 20.5,31.5"
                                  Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M 35.5,16 A 13,13 0 0 1 35.5,36 M 16.5,16 A 13,13 0 0 0 16.5,36"
                                  Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,3,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource Title}" />
                        <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Secondary}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,18,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Your voice" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    <c:LevelMeter Grid.Column="1" Level="{Binding Voice.Level}" Peak="{Binding Voice.Peak}" Fill="{DynamicResource MeterFill}" Track="{DynamicResource Sunken}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Voice.Text}" Style="{StaticResource Number}" HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="1" Text="Game" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    <c:LevelMeter Grid.Row="1" Grid.Column="1" Level="{Binding Game.Level}" Peak="{Binding Game.Peak}" Fill="{DynamicResource MeterFill}" Track="{DynamicResource Sunken}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Game.Text}" Style="{StaticResource Number}" HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="2" Text="To TeamSpeak" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    <c:LevelMeter Grid.Row="2" Grid.Column="1" Level="{Binding Output.Level}" Peak="{Binding Output.Peak}" Fill="{DynamicResource MeterFillStrong}" Track="{DynamicResource Sunken}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Output.Text}" Style="{StaticResource Number}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Mix -->
        <TextBlock Text="Sound" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <TextBlock Text="Send game audio over radio" Style="{StaticResource RowLabel}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GameAudioEnabled}" HorizontalAlignment="Right" AutomationProperties.Name="Send game audio over radio" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid Style="{StaticResource Row}">
                    <TextBlock Text="Mix" Style="{StaticResource RowLabel}" />
                    <c:SegmentedControl Items="{StaticResource Presets}" SelectedIndex="{Binding PresetIndex}" Width="196" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource Visible}}">
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="62" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Game level" Style="{StaticResource RowLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource Slider}" Minimum="-24" Maximum="6" Value="{Binding GameDb}" SmallChange="1" LargeChange="3" />
                        <TextBlock Grid.Column="2" Text="{Binding GameDbText}" Style="{StaticResource Number}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="62" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Voice level" Style="{StaticResource RowLabel}" />
                        <Slider Grid.Column="1" Style="{StaticResource Slider}" Minimum="-12" Maximum="12" Value="{Binding MicDb}" SmallChange="1" LargeChange="3" />
                        <TextBlock Grid.Column="2" Text="{Binding MicDbText}" Style="{StaticResource Number}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Lower the game while I talk" Style="{StaticResource RowLabel}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DuckEnabled}" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Visibility="{Binding DuckEnabled, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="By" Style="{StaticResource RowLabel}" Foreground="{DynamicResource Ink2}" Margin="14,0,0,0" />
                            <Slider Grid.Column="1" Style="{StaticResource Slider}" Minimum="1" Maximum="18" Value="{Binding DuckDb}" SmallChange="1" LargeChange="3" />
                            <TextBlock Grid.Column="2" Text="{Binding DuckDbText}" Style="{StaticResource Number}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Even out my voice" Style="{StaticResource RowLabel}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LevelerEnabled}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Catch loud peaks" Style="{StaticResource RowLabel}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LimiterEnabled}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding MixFootnote}" Style="{StaticResource Footnote}" Margin="16,8,16,0" />

        <!-- Radio keys -->
        <TextBlock Text="Radio keys" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Bindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Style="{StaticResource Row}" MinHeight="46">
                                    <ItemsControl ItemsSource="{Binding Keys}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Plus" Text="+" Style="{StaticResource Secondary}" Margin="6,0" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource KeyCap}">
                                                        <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Ink}" />
                                                    </Border>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                        <Setter TargetName="Plus" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding Remove}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Remove this key" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Style="{StaticResource Row}">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding AddKeyCommand}" Height="46" HorizontalAlignment="Left"
                            Visibility="{Binding Capturing, Converter={StaticResource Hidden}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,1,10,0" />
                            <TextBlock Text="Add a key" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Press the key or mouse button you use in Arma…  Esc cancels."
                               Style="{StaticResource Secondary}" VerticalAlignment="Center"
                               Visibility="{Binding Capturing, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ResetKeysCommand}" Height="46" HorizontalAlignment="Right"
                            FontSize="13" Content="Use ACRE defaults" Visibility="{Binding Capturing, Converter={StaticResource Hidden}}" />
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Footnote}" Margin="16,8,16,0"
                   Text="These only count while Arma is the active window. Ctrl + Alt + Caps Lock opens the radio screen, so it's left out." />
    </StackPanel>
</UserControl>
