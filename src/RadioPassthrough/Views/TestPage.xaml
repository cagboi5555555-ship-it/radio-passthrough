<UserControl x:Class="RadioPassthrough.Views.TestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:c="clr-namespace:RadioPassthrough.Controls"
             xmlns:local="clr-namespace:RadioPassthrough">
    <UserControl.Resources>
        <local:CheckLevelToBrush x:Key="LevelBrush" />
        <x:Array x:Key="Listen" Type="{x:Type sys:String}">
            <sys:String>What TeamSpeak gets</sys:String>
            <sys:String>What a teammate hears</sys:String>
        </x:Array>
        <x:Array x:Key="Signals" Type="{x:Type sys:String}">
            <sys:String>Strong</sys:String>
            <sys:String>Fair</sys:String>
            <sys:String>Weak</sys:String>
        </x:Array>
        <x:Array x:Key="TsListen" Type="{x:Type sys:String}">
            <sys:String>As TeamSpeak processed it</sys:String>
            <sys:String>On a teammate's radio</sys:String>
        </x:Array>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Secondary}" Margin="2,14,2,0"
                   Text="Play a video with gunfire in your browser, pick it below and record. Talk normally, then hold your radio key and keep talking. Nothing here changes your settings." />

        <TextBlock Text="Game audio" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Take it from" Style="{StaticResource RowLabel}" />
                <ComboBox Grid.Column="1" Style="{StaticResource PopupButton}" Margin="16,0,8,0"
                          ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" AutomationProperties.Name="Take game audio from">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="12"
                        Command="{Binding RefreshSourcesCommand}" ToolTip="Look for apps playing sound" AutomationProperties.Name="Refresh the list of apps" />
            </Grid>
        </Border>

        <Grid Margin="0,20,0,0">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RecordCommand}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource OnClay}" Margin="0,1,10,0" VerticalAlignment="Center"
                             Visibility="{Binding IsRecording, Converter={StaticResource Hidden}}" />
                    <TextBlock Text="{Binding RecordLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="24,0,24,6" Background="{DynamicResource OnClay}" Opacity="0.35"
                    Visibility="{Binding IsRecording, Converter={StaticResource Visible}}" HorizontalAlignment="Stretch">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding RecordProgress}" />
                </Border.RenderTransform>
            </Border>
        </Grid>

        <Button x:Name="HoldButton" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                PreviewMouseLeftButtonDown="Hold_Down" PreviewMouseLeftButtonUp="Hold_Up" MouseLeave="Hold_Leave">
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Hold here to talk on the radio" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Holding}" Value="True">
                                <Setter Property="Text" Value="On the radio" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
        <TextBlock Style="{StaticResource Footnote}" Margin="16,8,16,0" Text="Your real radio key works too, in any window, while a test runs." />

        <!-- Result -->
        <StackPanel Visibility="{Binding HasTake, Converter={StaticResource Visible}}">
            <TextBlock Text="Your recording" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:WaveformView Height="72" Margin="12,14,12,6" Samples="{Binding WaveSamples}" Spans="{Binding Spans}" Playhead="{Binding Playhead}"
                                    BarBrush="{DynamicResource WaveBar}" BandBrush="{DynamicResource WaveBand}" PlayheadBrush="{DynamicResource Ink}" />
                    <Grid Margin="16,0,16,12">
                        <TextBlock Style="{StaticResource Footnote}" Text="Shaded: radio key held" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PeakText}" Style="{StaticResource Number}" Foreground="{DynamicResource Ink3}" />
                            <TextBlock Text="{Binding LoudText}" Style="{StaticResource Number}" Foreground="{DynamicResource Ink3}" Margin="14,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <StackPanel Margin="16,12,16,12">
                        <TextBlock Text="Listen to" Style="{StaticResource RowLabel}" Margin="0,0,0,8" />
                        <c:SegmentedControl Items="{StaticResource Listen}" SelectedIndex="{Binding ListenIndex}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsTeammate, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="Signal" Style="{StaticResource RowLabel}" />
                            <c:SegmentedControl Items="{StaticResource Signals}" SelectedIndex="{Binding SignalIndex}" Width="228" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource Footnote}" Margin="16,0,16,12"
                                   Text="A preview only: TeamSpeak's compression, then the radio effect your teammates' ACRE2 adds on their side. The app itself never adds any of this to what you send." />
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="16,12">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding PlayCommand}" Width="132" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Margin="0,1,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlayLabel}" Value="Stop">
                                                    <Setter Property="Text" Value="&#xE71A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding PlayMessage}" Style="{StaticResource Footnote}" Margin="16,0,16,12"
                               Visibility="{Binding PlayMessage, Converter={StaticResource NotNull}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Checks" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}" Padding="0,6">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"
                                         Fill="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Secondary}" Foreground="{DynamicResource Ink}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- TeamSpeak's own processing -->
        <TextBlock Text="Through TeamSpeak" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Secondary}" Foreground="{DynamicResource Ink}"
                           Text="Hear TeamSpeak's own noise removal and volume control on the mix. Press Start, then in TeamSpeak open Options → Capture, click Begin Test and talk for a bit. The radio is held open for you." />
                <Grid Margin="0,14,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding TeamSpeakTestCommand}" Content="{Binding TsLabel}" HorizontalAlignment="Left" />
                </Grid>
                <Border Height="4" CornerRadius="2" Background="{DynamicResource Sunken}" Margin="0,12,0,0"
                        Visibility="{Binding TsRunning, Converter={StaticResource Visible}}">
                    <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource MeterFill}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource Fraction}">
                                <Binding Path="TsProgress" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
                <TextBlock Text="{Binding TsMessage}" Style="{StaticResource Footnote}" Margin="0,10,0,0"
                           Visibility="{Binding TsMessage, Converter={StaticResource NotNull}}" />
                <StackPanel Visibility="{Binding HasTsClip, Converter={StaticResource Visible}}" Margin="0,12,0,0">
                    <c:SegmentedControl Items="{StaticResource TsListen}" SelectedIndex="{Binding TsListenIndex}" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding PlayTeamSpeakCommand}" Width="132" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding PlayTsLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
