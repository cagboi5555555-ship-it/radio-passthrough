<Window x:Class="RadioPassthrough.Dialogs.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Radio Passthrough"
        Width="488" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Style="{StaticResource Sheet}" MouseLeftButtonDown="Drag">
        <Grid>
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                    Click="Cancel_Click" ToolTip="Close" AutomationProperties.Name="Close" x:Name="CloseButton" />
            <StackPanel Margin="30,30,30,24">
                <Image Source="pack://application:,,,/Assets/app.png" Width="64" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Radio Passthrough" Style="{StaticResource LargeTitle}" FontSize="28" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="14" Margin="0,4,0,0"
                           Text="Your teammates hear the fight behind your voice when you talk on an ACRE2 radio." />

                <!-- Updating: what changes and what stays. Replaces the first-install card below. -->
                <Border x:Name="UpdateCard" Style="{StaticResource Card}" Margin="0,22,0,0" Padding="16,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="UpdateTitle" Style="{StaticResource RowLabel}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Your settings, radio keys and TeamSpeak setup stay as they are. Radio Passthrough closes for a moment and starts again by itself." />
                    </StackPanel>
                </Border>

                <Border x:Name="InstallCard" Style="{StaticResource Card}" Margin="0,22,0,0" Padding="16,6">
                    <StackPanel>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Foreground="{DynamicResource Ink}" Text="Installs for your Windows account. No admin rights needed." />
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Foreground="{DynamicResource Ink}" Text="Starts with Windows and waits quietly in the tray." />
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Foreground="{DynamicResource Ink}" Text="Then a short checklist sets up VB-CABLE and TeamSpeak for you." />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="16,16,4,0">
                    <TextBlock Text="Desktop shortcut" Style="{StaticResource RowLabel}" />
                    <CheckBox x:Name="DesktopShortcut" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" />
                </Grid>

                <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" Margin="0,16,0,0" Visibility="Collapsed" />

                <Grid Margin="0,22,0,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Number}" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel" Height="40" MinWidth="100" Click="Cancel_Click" IsCancel="True" />
                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Install" Height="40" MinWidth="128" FontSize="16" Margin="10,0,0,0" Click="Install_Click" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
