<Window x:Class="RadioPassthrough.Dialogs.SheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radio Passthrough"
        Width="448" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Style="{StaticResource Sheet}" MouseLeftButtonDown="Drag">
        <StackPanel Margin="26,24,26,22">
            <TextBlock x:Name="TitleText" Style="{StaticResource Title}" FontSize="21" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" Style="{StaticResource Secondary}" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}" Height="38" MinWidth="104" Click="Secondary_Click" IsCancel="True" />
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="104" FontSize="15" Margin="10,0,0,0" Click="Primary_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
